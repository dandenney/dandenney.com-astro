{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft-Ready No Reservaitions Content Packet",
  "description": "Contract for packets that have completed intake and research and are ready to draft. Paused research state with followUpNeeded=true is intentionally not draft-ready.",
  "type": "object",
  "required": [
    "type",
    "sourceInput",
    "location",
    "narrativeContext",
    "frontmatter",
    "bodyBrief",
    "sources",
    "confidence"
  ],
  "properties": {
    "type": { "const": "no-reservaitions" },
    "sourceInput": {
      "type": "object",
      "required": ["location", "city", "items"],
      "properties": {
        "location": { "type": "string" },
        "city": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "notes": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["title", "address", "city", "state", "country", "coordinates"],
      "properties": {
        "title": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "coordinates": { "type": "string", "pattern": "^-?\\d{1,3}\\.\\d{4,},\\s*-?\\d{1,2}\\.\\d{4,}$" },
        "infoUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "narrativeContext": {
      "type": "object",
      "required": ["firsthand", "researched", "missing", "followUpNeeded"],
      "properties": {
        "firsthand": {
          "type": "object",
          "required": ["whyThere", "companionsOrOccasion", "roomOrSetting", "strongestSensoryMemory"],
          "properties": {
            "whyThere": { "type": ["string", "null"] },
            "companionsOrOccasion": { "type": ["string", "null"] },
            "roomOrSetting": { "type": ["string", "null"] },
            "strongestSensoryMemory": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "researched": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "sourceUrl"],
            "properties": {
              "claim": { "type": "string", "minLength": 1 },
              "sourceUrl": { "type": "string", "format": "uri" }
            },
            "additionalProperties": false
          }
        },
        "missing": {
          "type": "array",
          "items": { "type": "string" }
        },
        "followUpNeeded": { "const": false }
      },
      "anyOf": [
        {
          "properties": {
            "researched": { "minItems": 2 }
          }
        },
        {
          "properties": {
            "researched": { "minItems": 1 },
            "firsthand": {
              "properties": { "whyThere": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "properties": {
            "researched": { "minItems": 1 },
            "firsthand": {
              "properties": { "companionsOrOccasion": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "properties": {
            "researched": { "minItems": 1 },
            "firsthand": {
              "properties": { "roomOrSetting": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "properties": {
            "researched": { "minItems": 1 },
            "firsthand": {
              "properties": { "strongestSensoryMemory": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "properties": {
            "firsthand": {
              "properties": {
                "whyThere": { "type": "string", "minLength": 1 },
                "companionsOrOccasion": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "firsthand": {
              "properties": {
                "whyThere": { "type": "string", "minLength": 1 },
                "roomOrSetting": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "firsthand": {
              "properties": {
                "whyThere": { "type": "string", "minLength": 1 },
                "strongestSensoryMemory": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "firsthand": {
              "properties": {
                "companionsOrOccasion": { "type": "string", "minLength": 1 },
                "roomOrSetting": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "firsthand": {
              "properties": {
                "companionsOrOccasion": { "type": "string", "minLength": 1 },
                "strongestSensoryMemory": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "firsthand": {
              "properties": {
                "roomOrSetting": { "type": "string", "minLength": 1 },
                "strongestSensoryMemory": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "frontmatter": {
      "type": "object",
      "required": ["title", "address", "city", "state", "country", "coordinates", "description", "tags", "pubDate", "aiGenerated"],
      "properties": {
        "title": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "coordinates": { "type": "string", "pattern": "^-?\\d{1,3}\\.\\d{4,},\\s*-?\\d{1,2}\\.\\d{4,}$" },
        "description": { "type": "string" },
        "heroImageAlt": { "type": "string" },
        "heroImage": { "type": "string" },
        "infoUrl": { "type": ["string", "null"], "format": "uri" },
        "pubDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 4
        },
        "aiGenerated": { "type": "boolean" }
      }
    },
    "bodyBrief": {
      "type": "object",
      "required": ["angle", "mustInclude", "mustAvoid"],
      "properties": {
        "angle": { "type": "string" },
        "mustInclude": { "type": "array", "items": { "type": "string" } },
        "mustAvoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "kind": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "flags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
