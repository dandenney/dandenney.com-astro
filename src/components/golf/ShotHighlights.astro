---
/** Selected launch-monitor shots. These are individual receipts, not averages. */
import { CLUB_SHORT, type ShotHighlight } from '@/data/golf/types';
import ShotMetric from '@/components/golf/ShotMetric.astro';

interface Props {
  shots: ShotHighlight[];
  titleId: string;
}

const { shots, titleId } = Astro.props;
const shotCount = `${shots.length} saved ${shots.length === 1 ? 'shot' : 'shots'}`;
---

<section class="shots" aria-labelledby={titleId}>
  <header class="shots-head">
    <h3 id={titleId} class="gf-label">Selected shot highlights</h3>
    <span class="gf-mono shots-note">{shotCount}, not session averages</span>
  </header>
  <div class="shots-scroll" role="region" aria-labelledby={titleId} tabindex="0">
    <table class="gf-table shots-table">
      <thead>
        <tr>
          <th scope="col">Shot</th>
          <th scope="col">Total</th>
          <th scope="col">Carry</th>
          <th scope="col">Offline</th>
          <th scope="col">Ball spd</th>
          <th scope="col">Club spd</th>
          <th scope="col">Smash</th>
          <th scope="col">Launch</th>
          <th scope="col">Back spin</th>
          <th scope="col">Descent</th>
          <th scope="col">Height</th>
          <th scope="col">Side</th>
          <th scope="col">Side spin</th>
          <th scope="col">Path</th>
          <th scope="col">Face/path</th>
          <th scope="col">Face/target</th>
          <th scope="col">Score</th>
        </tr>
      </thead>
      <tbody>
        {shots.map((shot) => (
          <tr>
            <th scope="row" class="shot-id">
              <span class="shot-club">{CLUB_SHORT[shot.club]}</span>
              <span>Shot {shot.shotNumber ?? 'not recorded'}{shot.shotSetTotal ? `/${shot.shotSetTotal}` : ''}</span>
            </th>
            <td class="shot-distance"><ShotMetric value={shot.total} unit="yd" /></td>
            <td class="shot-distance"><ShotMetric value={shot.carry} unit="yd" /></td>
            <td><ShotMetric value={shot.offline} direction /></td>
            <td><ShotMetric value={shot.ballSpeed} unit="mph" /></td>
            <td><ShotMetric value={shot.clubSpeed} unit="mph" /></td>
            <td><ShotMetric value={shot.smashFactor} decimals={2} /></td>
            <td><ShotMetric value={shot.launchAngle} unit="°" /></td>
            <td><ShotMetric value={shot.backSpin} unit="rpm" /></td>
            <td><ShotMetric value={shot.descentAngle} unit="°" /></td>
            <td><ShotMetric value={shot.maxHeight} unit="yd" /></td>
            <td><ShotMetric value={shot.sideAngle} unit="°" signed /></td>
            <td><ShotMetric value={shot.sideSpin} unit="rpm" signed /></td>
            <td><ShotMetric value={shot.clubPath} unit="°" decimals={1} signed /></td>
            <td><ShotMetric value={shot.faceToPath} unit="°" decimals={1} signed /></td>
            <td><ShotMetric value={shot.faceToTarget} unit="°" decimals={1} signed /></td>
            <td><ShotMetric value={shot.shotScore} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="gf-mono shots-key">Direction: R/L from target · positive path is in-to-out · positive face is open</p>
</section>

<style>
  .shots {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 0.25rem;
  }
  .shots-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .shots-note,
  .shots-key {
    color: var(--gf-mute);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .shots-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-top: 1px solid var(--gf-line);
  }
  .shots-table {
    min-width: 78rem;
  }
  .shots-table th,
  .shots-table td {
    white-space: nowrap;
  }
  .shots-table th.shot-id {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 7rem;
    text-align: left;
    background: var(--gf-bay);
    color: var(--gf-ink);
    border-bottom: 1px solid var(--gf-line-soft);
  }
  .shot-club {
    color: var(--gf-tracer);
    margin-right: 0.45rem;
  }
  .shot-distance {
    color: var(--gf-tracer);
  }
  .shots-key {
    margin: 0;
  }
</style>
