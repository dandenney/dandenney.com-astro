---
import "@/styles/course.css";
import { comparablePicks, sourceLabels, toClientPick, unitsFor, type Source } from "@/data/jev/coursePicks";

const picks = comparablePicks.map(toClientPick);
const sources = Object.entries(sourceLabels) as [Source, string][];
const allUnits = unitsFor(comparablePicks);
---

<threshold-lab class="course-card" data-picks={JSON.stringify(picks)}>
  <div class="course-label">Lab · Thresholds are break-even</div>
  <div class="course-title">Bet only when the model beats the price</div>
  <div class="course-muted">
    Every pick's odds set a break-even hit rate. The rule: bet when the probability clears break-even by at least the
    margin. Betting all {picks.length} picks went {picks.filter((p) => p.win).length}–{picks.filter((p) => !p.win).length}
    for <span class="course-mono">{allUnits >= 0 ? "+" : ""}{allUnits.toFixed(2)}</span> units.
  </div>

  <div class="lab-sources" role="group" aria-label="Whose probability to use">
    {sources.map(([source, label], index) => (
      <button type="button" class="course-btn" data-source={source} aria-pressed={index === 1 ? "true" : "false"}>
        {label}
      </button>
    ))}
  </div>

  <label class="lab-control">
    <span>Margin over break-even: <strong class="course-mono" data-margin-out></strong></span>
    <input class="course-range" type="range" min="-10" max="15" step="1" value="0" data-margin />
  </label>

  <div class="lab-stats" aria-live="polite">
    <div><span class="course-label">bets</span><strong class="course-mono" data-bets></strong></div>
    <div><span class="course-label">record</span><strong class="course-mono" data-record></strong></div>
    <div><span class="course-label">units</span><strong class="course-mono" data-units></strong></div>
    <div><span class="course-label">per bet</span><strong class="course-mono" data-roi></strong></div>
  </div>

  <figure class="lab-curve">
    <svg viewBox="0 0 400 140" role="img" aria-label="Units won at each margin" data-curve></svg>
    <figcaption class="course-muted">Units at every margin from -10 to +15 points. The dot is where you are.</figcaption>
  </figure>

  <div class="course-feedback" aria-live="polite" data-summary></div>
</threshold-lab>

<style>
  .lab-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .lab-control {
    display: grid;
    font-size: 0.9rem;
    gap: 0.25rem;
    margin-top: 1rem;
  }

  .lab-stats {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
    margin-top: 1rem;
  }

  .lab-stats div {
    background: var(--course-surface);
    border: 1px solid var(--course-border);
    border-radius: 0.5rem;
    display: grid;
    padding: 0.5rem 0.75rem;
  }

  .lab-stats strong {
    font-size: 1.1rem;
  }

  .lab-curve {
    margin: 1rem 0 0;
  }

  .lab-curve svg {
    display: block;
    height: auto;
    width: 100%;
  }
</style>

<style is:global>
  threshold-lab .curve-line {
    fill: none;
    stroke: var(--course-accent);
    stroke-width: 2;
  }

  threshold-lab .curve-zero {
    stroke: var(--course-border);
    stroke-dasharray: 4 4;
  }

  threshold-lab .curve-dot {
    fill: var(--course-accent);
  }

  threshold-lab .curve-text {
    fill: var(--course-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 8px;
  }
</style>

<script>
  import type { ClientPick, Source } from "@/data/jev/coursePicks";

  const signed = (value: number) => `${value >= 0 ? "+" : ""}${value.toFixed(2)}`;

  class ThresholdLab extends HTMLElement {
    connectedCallback() {
      const picks = JSON.parse(this.dataset.picks ?? "[]") as ClientPick[];
      const margin = this.querySelector<HTMLInputElement>("[data-margin]")!;
      const curve = this.querySelector<SVGSVGElement>("[data-curve]")!;
      const sourceButtons = [...this.querySelectorAll<HTMLButtonElement>("[data-source]")];
      const field = (name: string) => this.querySelector<HTMLElement>(`[data-${name}]`)!;
      let source: Source = "facts";

      const probability = (pick: ClientPick) => (source === "rithmm" ? pick.rithmm! : pick[source]);
      const select = (points: number) => picks.filter((pick) => probability(pick) > pick.breakEven + points / 100);
      const units = (chosen: ClientPick[]) => chosen.reduce((total, pick) => total + (pick.win ? pick.payout : -1), 0);

      const drawCurve = (current: number) => {
        const margins = Array.from({ length: 26 }, (_, i) => i - 10);
        const values = margins.map((m) => units(select(m)));
        const top = Math.max(5, ...values);
        const bottom = Math.min(0, ...values);
        const x = (m: number) => 20 + ((m + 10) / 25) * 360;
        const y = (u: number) => 115 - ((u - bottom) / (top - bottom)) * 100;
        const path = margins.map((m, i) => `${i ? "L" : "M"}${x(m).toFixed(1)},${y(values[i]).toFixed(1)}`).join(" ");
        const at = values[current + 10];
        curve.innerHTML = `
          <line class="curve-zero" x1="20" x2="380" y1="${y(0)}" y2="${y(0)}" />
          <text class="curve-text" x="20" y="${y(0) - 4}">0 units</text>
          <text class="curve-text" x="20" y="136">-10</text>
          <text class="curve-text" x="${x(0) - 3}" y="136">0</text>
          <text class="curve-text" x="366" y="136">+15</text>
          <path class="curve-line" d="${path}" />
          <circle class="curve-dot" cx="${x(current)}" cy="${y(at)}" r="4" />`;
      };

      const render = () => {
        const points = Number(margin.value);
        const chosen = select(points);
        const wins = chosen.filter((pick) => pick.win).length;
        const total = units(chosen);
        field("margin-out").textContent = `${points >= 0 ? "+" : ""}${points} points`;
        field("bets").textContent = String(chosen.length);
        field("record").textContent = `${wins}–${chosen.length - wins}`;
        field("units").textContent = signed(total);
        field("roi").textContent = chosen.length ? signed(total / chosen.length) : "–";
        sourceButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.source === source)));
        drawCurve(points);

        const summary = field("summary");
        if (source === "rithmm" && points <= 0) {
          summary.dataset.state = "wrong";
          summary.textContent = "Rithmm's confidence beat break-even on every single pick, so at zero margin its rule is just \"bet everything.\" A threshold only helps if the numbers spread out.";
        } else if (chosen.length < 30) {
          summary.dataset.state = "wrong";
          summary.textContent = `Only ${chosen.length} bets. Anything can happen in a sample that small, so don't read much into the units here.`;
        } else {
          summary.dataset.state = total > 0 ? "correct" : "wrong";
          summary.textContent = `${chosen.length} of ${picks.length} picks clear the bar and they hit ${Math.round((wins / chosen.length) * 100)}% of the time.`;
        }
      };

      margin.addEventListener("input", render);
      sourceButtons.forEach((button) =>
        button.addEventListener("click", () => {
          source = button.dataset.source as Source;
          render();
        }),
      );
      render();
    }
  }

  if (!customElements.get("threshold-lab")) customElements.define("threshold-lab", ThresholdLab);
</script>
