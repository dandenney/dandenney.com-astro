---
interface Props {
	title: string;
	kind: 'web' | 'package';
	url: string;
	image?: string;
	imageAlt?: string;
	class?: string;
}

const { title, kind, url, image, imageAlt, class: className } = Astro.props;
const packageName = kind === 'package' ? url.split('/').pop() : undefined;
---

{image ? (
	<img src={image} alt={imageAlt ?? `${title} preview`} width="1200" height="630" loading="lazy" class={className} />
) : (
	<div class:list={['factory-cover', className]} role="img" aria-label={`${title} preview`}>
		<span class="factory-cover__prompt" aria-hidden="true">$</span>
		<span>{packageName ? `npx ${packageName}` : title}</span>
		<span class="factory-cover__cursor" aria-hidden="true"></span>
	</div>
)}

<style>
	.factory-cover {
		align-items: center;
		background: #0f172a;
		color: #e2e8f0;
		display: flex;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: clamp(1.25rem, 3vw, 2rem);
		gap: 0.6em;
		justify-content: center;
	}

	.factory-cover__prompt {
		color: #f87171;
	}

	.factory-cover__cursor {
		animation: factory-cover-blink 1.1s steps(1) infinite;
		background: currentColor;
		display: inline-block;
		height: 1.1em;
		width: 0.55em;
	}

	@keyframes factory-cover-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.factory-cover__cursor {
			animation: none;
		}
	}
</style>
