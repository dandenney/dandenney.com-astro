---
import { type CollectionEntry, getCollection, render } from "astro:content";
import SongReview from "@/layouts/SongReview.astro";
import { twinUrlForId } from "@/lib/markdownTwin";
import { orderByLately, songSlug as slugFor } from "@/lib/lately";

export const prerender = true;

export async function getStaticPaths() {
  const { active, retired } = orderByLately(await getCollection("songs"));
  const songs = [...active, ...retired];
  return songs.map((song, i) => {
    const inRotation = i < active.length;
    const next = inRotation ? active[(i + 1) % active.length] : active[0];
    return {
      params: { slug: slugFor(song) },
      props: {
        song,
        slug: slugFor(song),
        addedAt: song.addedAt,
        trackNumber: inRotation ? i + 1 : null,
        totalTracks: active.length,
        next: {
          slug: slugFor(next),
          title: next.data.title,
          artist: next.data.artist,
          duration: next.data.duration,
          albumArt: next.data.albumArt,
        },
      },
    };
  });
}

type Props = {
  song: CollectionEntry<"songs">;
  slug: string;
  addedAt: string | null;
  trackNumber: number | null;
  totalTracks: number;
  next: {
    slug: string;
    title: string;
    artist: string;
    duration: number;
    albumArt?: string;
  };
};

const { song, slug, addedAt, trackNumber, totalTracks, next } = Astro.props;
const { Content } = await render(song);
---

<SongReview
  {...song.data}
  slug={slug}
  addedAt={addedAt}
  trackNumber={trackNumber}
  totalTracks={totalTracks}
  next={next}
  markdownTwin={twinUrlForId("songs", song.id)}
  rawBody={song.body}
>
  <Content />
</SongReview>
