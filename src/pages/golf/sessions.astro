---
/**
 * /golf/sessions, the full ledger. Sessions and rounds, filterable by
 * venue, kind, and club. Density done well: locked tabular columns and
 * hairline rules, not a card list.
 */
import Golf from '@/layouts/Golf.astro';
import SessionRow from '@/components/golf/SessionRow.astro';
import { CLUB_LABEL, CLUB_ORDER, GOLF_SECTION_NAME, type Club } from '@/data/golf/types';
import { SESSION_KIND_LABEL, getRounds, getSessionPRFlags, getSessions } from '@/data/golf/utils';
import { getVenueMap, venueHref, venueName } from '@/helpers/golf';

export const prerender = true;

const player = 'dan';
const vmap = await getVenueMap();
const sessions = getSessions(player);
const rounds = getRounds(player);
const prFlags = getSessionPRFlags(player);

const items = [...sessions, ...rounds].sort((a, b) => b.date.localeCompare(a.date) || b.id - a.id);

const venueSlugs = Array.from(new Set(items.map((i) => i.venueSlug)));
const kinds = Array.from(new Set(sessions.map((s) => s.kind)));
const clubs = CLUB_ORDER.filter((c) => sessions.some((s) => s.clubs.some((x) => x.club === c)));
const prCount = Array.from(prFlags.values()).reduce((n, set) => n + set.size, 0);
---

<Golf title={`The log · ${GOLF_SECTION_NAME}`} description="Every practice session and round, with the club-by-club numbers where they exist.">
	<section class="gf-wrap page">
		<header class="page-head">
			<p class="gf-label"><a class="crumb" href="/golf">{GOLF_SECTION_NAME}</a> &middot; Sessions</p>
			<h1 class="gf-display page-title">The log</h1>
			<p class="page-lede">Every session and round. Expand one for the numbers. A <span class="gf-pr">value</span> marked in green was a record at the time.</p>
		</header>

		<form class="filters" data-log-filters aria-label="Filter the log">
			<label class="filt">
				<span class="gf-label">Venue</span>
				<select name="venue" class="gf-mono">
					<option value="">All</option>
					{venueSlugs.map((s) => <option value={s}>{venueName(vmap, s)}</option>)}
				</select>
			</label>
			<label class="filt">
				<span class="gf-label">Kind</span>
				<select name="kind" class="gf-mono">
					<option value="">All</option>
					{kinds.map((k) => <option value={k}>{SESSION_KIND_LABEL[k]}</option>)}
					{rounds.length > 0 && <option value="round">Round</option>}
				</select>
			</label>
			<label class="filt">
				<span class="gf-label">Club</span>
				<select name="club" class="gf-mono" disabled={clubs.length === 0}>
					<option value="">Any</option>
					{clubs.map((c: Club) => <option value={c}>{CLUB_LABEL[c]}</option>)}
				</select>
			</label>
			<span class="gf-mono count" data-log-count>{items.length} of {items.length}</span>
			<button type="reset" class="gf-btn">Clear</button>
		</form>

		<div class="log-head gf-label" aria-hidden="true">
			<span></span><span>Date</span><span>Venue</span><span>Kind</span><span>Headline</span><span>Note</span><span></span>
		</div>
		<div class="log" data-log>
			{items.map((item) => (
				<SessionRow
					item={item}
					venue={venueName(vmap, item.venueSlug)}
					venueHref={venueHref(item.venueSlug)}
					prFlags={'clubs' in item ? prFlags.get(item.id) : undefined}
				/>
			))}
			<p class="gf-empty log-none gf-mono" data-log-none hidden>&mdash; nothing matches &mdash;</p>
		</div>

		<p class="gf-mono foot">{sessions.length} sessions &middot; {rounds.length} rounds &middot; {prCount} record{prCount === 1 ? '' : 's'} set along the way</p>
	</section>
</Golf>

<script>
	function init() {
		const form = document.querySelector<HTMLFormElement>('[data-log-filters]');
		const rows = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-session-row]'));
		const count = document.querySelector<HTMLElement>('[data-log-count]');
		const none = document.querySelector<HTMLElement>('[data-log-none]');
		if (!form || form.dataset.ready) return;
		form.dataset.ready = '1';

		const apply = () => {
			const fd = new FormData(form);
			const venue = String(fd.get('venue') ?? '');
			const kind = String(fd.get('kind') ?? '');
			const club = String(fd.get('club') ?? '');
			let shown = 0;
			rows.forEach((r) => {
				const ok =
					(!venue || r.dataset.venue === venue) &&
					(!kind || r.dataset.kind === kind) &&
					(!club || (r.dataset.clubs ?? '').split(' ').includes(club));
				r.hidden = !ok;
				if (ok) shown++;
			});
			if (count) count.textContent = `${shown} of ${rows.length}`;
			if (none) none.hidden = shown > 0;
		};

		form.addEventListener('change', apply);
		form.addEventListener('reset', () => requestAnimationFrame(apply));

		const openHash = () => {
			const id = location.hash.slice(1);
			if (!id) return;
			const d = document.getElementById(id);
			if (d instanceof HTMLDetailsElement) {
				d.open = true;
				d.scrollIntoView({ block: 'center' });
			}
		};
		openHash();
		window.addEventListener('hashchange', openHash);
	}
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.page {
		padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
	}
	.page-head {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.crumb {
		color: inherit;
		text-decoration: none;
	}
	.crumb:hover {
		color: var(--gf-tracer);
	}
	.page-title {
		font-size: clamp(3rem, 8vw, 6.5rem);
		margin-left: -0.04em;
	}
	.page-lede {
		font-family: var(--gf-serif);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		color: var(--gf-ink-soft);
		max-width: 56ch;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 1rem 1.5rem;
		padding: 1rem 0;
		border-top: 1px solid var(--gf-line);
	}
	.filt {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.filt select {
		appearance: none;
		background: var(--gf-panel);
		color: var(--gf-ink);
		border: 1px solid var(--gf-line);
		padding: 0.55rem 2rem 0.5rem 0.75rem;
		font-size: 0.78rem;
		min-width: 12rem;
		background-image: linear-gradient(45deg, transparent 50%, var(--gf-dim) 50%), linear-gradient(135deg, var(--gf-dim) 50%, transparent 50%);
		background-position: calc(100% - 16px) 55%, calc(100% - 11px) 55%;
		background-size: 5px 5px;
		background-repeat: no-repeat;
	}
	.filt select:disabled {
		opacity: 0.4;
	}
	.count {
		margin-left: auto;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gf-dim);
		align-self: center;
	}
	.log-head {
		display: grid;
		grid-template-columns: 1.4rem 6.5rem minmax(9rem, 1.2fr) 6rem minmax(7rem, 0.9fr) minmax(0, 2fr) 1.5rem;
		gap: 0 1rem;
		padding: 0.6rem 0;
		border-top: 1px solid var(--gf-line);
		border-bottom: 1px solid var(--gf-line);
	}
	.log :global(details[hidden]) {
		display: none;
	}
	.log-none {
		margin-top: 1rem;
		padding: 1.5rem;
		text-align: center;
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.foot {
		margin-top: 1.5rem;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--gf-mute);
	}
	@media (max-width: 860px) {
		.log-head {
			display: none;
		}
	}
</style>
