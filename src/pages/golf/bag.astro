---
/**
 * /golf/bag, the equipment. Distance-ordered, longest club at the top,
 * with average carry pulled from sessions. Retired gear below, dimmed,
 * with what replaced it.
 */
import Golf from '@/layouts/Golf.astro';
import BagRow from '@/components/golf/BagRow.astro';
import { GOLF_SECTION_NAME } from '@/data/golf/types';
import { getBag } from '@/data/golf/utils';
import YardageCard from '@/components/golf/YardageCard.astro';
import { YARDAGE_APP_URL, getYardagePlayers, yardageGoodShots, yardagesExportedAt } from '@/data/golf/yardages';

export const prerender = true;

const player = 'dan';
const { inBag, retired, other } = getBag(player);
const total = inBag.length + retired.length + other.length;
const yardagePlayers = [...getYardagePlayers()].sort((a, b) => Number(b.id === player) - Number(a.id === player));
const exportedAt = yardagesExportedAt();
const exportedOn = exportedAt
	? new Date(exportedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' })
	: undefined;
---

<Golf title={`The bag · ${GOLF_SECTION_NAME}`} description="What is in the bag, what it carries, and what it replaced.">
	<section class="gf-wrap page">
		<header class="page-head">
			<p class="gf-label"><a class="crumb" href="/golf">{GOLF_SECTION_NAME}</a> &middot; Bag</p>
			<h1 class="gf-display page-title">The bag</h1>
			<p class="page-lede">
				Longest club at the top, the way it is organised in the head. Carry numbers come from sessions, so the bag and the metrics talk to each other.
			</p>
		</header>

		{yardagePlayers.length > 0 && (
			<section class="group" id="stock-yardages">
				<div class="gf-section-head">
					<h2 class="gf-h2"><span class="gf-idx">Yd</span> Stock yardages</h2>
					<span class="gf-label">
						Last {yardageGoodShots()} good shots{exportedOn && <> &middot; {exportedOn}</>} &middot; <a href={YARDAGE_APP_URL}>Stock Yardage &rarr;</a>
					</span>
				</div>
				<p class="gf-mono yd-key">
					<span class="yd-key-tee"></span>Tee <span class="yd-key-ground"></span>No tee <span class="yd-key-note">Carry. Bar is low to high, tick is typical.</span>
				</p>
				{yardagePlayers.map((p) => (
					<div class="yd-player" data-reveal>
						{yardagePlayers.length > 1 && <h3 class="gf-label yd-name">{p.name}</h3>}
						<YardageCard clubs={p.card} />
					</div>
				))}
			</section>
		)}

		{total === 0 ? (
			<div class="gf-empty empty" data-reveal>
				<span class="gf-mono empty-k">&mdash; nothing logged yet &mdash;</span>
				<p class="empty-t">
					Clubs go in after the first fitting. Once they do, each row shows brand, loft, shaft, when it arrived, and its average carry across every session that logged it.
				</p>
				<div class="empty-cols gf-label" aria-hidden="true">
					<span>Club</span><span>What</span><span>When</span><span>Carry</span><span>Why</span>
				</div>
			</div>
		) : (
			<>
				{inBag.length > 0 && (
					<section class="group">
						<div class="gf-section-head">
							<h2 class="gf-h2"><span class="gf-idx">In</span> In the bag</h2>
							<span class="gf-label">{inBag.length} clubs</span>
						</div>
						<div class="rows" data-reveal data-reveal-children>
							{inBag.map((row) => <BagRow row={row} />)}
						</div>
					</section>
				)}
				{other.length > 0 && (
					<section class="group">
						<div class="gf-section-head">
							<h2 class="gf-h2"><span class="gf-idx">+</span> Balls and gear</h2>
						</div>
						<div class="rows">
							{other.map((row) => <BagRow row={row} />)}
						</div>
					</section>
				)}
				{retired.length > 0 && (
					<section class="group">
						<div class="gf-section-head">
							<h2 class="gf-h2"><span class="gf-idx">Out</span> Out of the bag</h2>
							<span class="gf-label">The upgrade path</span>
						</div>
						<div class="rows">
							{retired.map((row) => <BagRow row={row} retired />)}
						</div>
					</section>
				)}
			</>
		)}
	</section>
</Golf>

<style>
	.page {
		padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
	}
	.page-head {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.crumb {
		color: inherit;
		text-decoration: none;
	}
	.crumb:hover {
		color: var(--gf-tracer);
	}
	.page-title {
		font-size: clamp(3rem, 8vw, 6.5rem);
		margin-left: -0.04em;
	}
	.page-lede {
		font-family: var(--gf-serif);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		color: var(--gf-ink-soft);
		max-width: 56ch;
	}
	.empty {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 3vw, 2rem);
	}
	.empty-k {
		font-size: 0.85rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.empty-t {
		font-family: var(--gf-serif);
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--gf-dim);
		max-width: 56ch;
	}
	.empty-cols {
		display: grid;
		grid-template-columns: 3rem 1.3fr 0.9fr 0.8fr 1.6fr;
		gap: 1.25rem;
		margin-top: 1rem;
		padding-top: 0.75rem;
		border-top: 1px dashed var(--gf-line);
		color: var(--gf-mute);
	}
	.yd-key {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 1rem;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gf-dim);
	}
	.yd-key-tee,
	.yd-key-ground {
		display: inline-block;
		width: 1.1rem;
		height: 4px;
		border-radius: 2px;
		background: var(--gf-tracer);
	}
	.yd-key-ground {
		margin-left: 0.75rem;
		background: var(--gf-cool);
	}
	.yd-key-note {
		margin-left: 0.75rem;
		text-transform: none;
		letter-spacing: 0;
		color: var(--gf-mute);
	}
	.yd-player + .yd-player {
		margin-top: 2rem;
	}
	.yd-name {
		margin-bottom: 0.5rem;
	}
	#stock-yardages {
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}
	.group + .group {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.rows {
		border-top: 1px solid var(--gf-line);
	}
	@media (max-width: 800px) {
		.empty-cols {
			display: none;
		}
	}
</style>
