---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ClientRouter } from 'astro:transitions';

const { summary, title } = Astro.props;
---

<BaseLayout title={title} description={summary}>
	<Fragment slot="head">
		<ClientRouter />
	</Fragment>
		<main>
    	<slot />
		</main>
</BaseLayout>
