---
/**
 * Shell for every Ball Flight page: dark-only set, section fonts, header
 * overrides, and the shared GSAP motion primitives (tracer draw, count-up,
 * chart wipe, reveal). Pages compose the rest.
 */
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '@/styles/golf.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	datePublished?: Date;
}

const { title, description, image, datePublished } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} datePublished={datePublished} />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
	</head>
	<body class="golf">
		<main id="main-content" tabindex="-1" class="relative shadow-xs z-10">
			<Header />
			<slot />
		</main>
		<Footer />

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			function init() {
				const mm = gsap.matchMedia();

				mm.add('(prefers-reduced-motion: no-preference)', () => {
					/* Tracer arcs draw from tee to ball. The section's signature move. */
					document.querySelectorAll<SVGElement>('[data-tracer]').forEach((svg) => {
						const paths = svg.querySelectorAll<SVGPathElement>('[data-tracer-path]');
						const ball = svg.querySelector<SVGElement>('[data-tracer-ball]');
						const roll = svg.querySelector<SVGElement>('[data-tracer-roll]');
						const duration = Number(svg.dataset.tracerDuration ?? 0.7);
						const tl = gsap.timeline({
							scrollTrigger: { trigger: svg, start: 'top 90%', once: true },
						});
						tl.fromTo(
							paths,
							{ strokeDashoffset: 1 },
							{ strokeDashoffset: 0, duration, ease: 'power2.out' },
						);
						if (ball) {
							tl.fromTo(
								ball,
								{ scale: 0, transformOrigin: 'center', opacity: 0 },
								{ scale: 1, opacity: 1, duration: 0.35, ease: 'back.out(2.5)' },
								'-=0.12',
							);
						}
						if (roll) {
							tl.fromTo(roll, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.4, ease: 'power1.out' }, '-=0.2');
						}
					});

					/* Hero-scale numerals count up on first view. Tabular, so no shift. */
					document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
						const target = Number(el.dataset.countup);
						const decimals = Number(el.dataset.decimals ?? 0);
						if (!Number.isFinite(target)) return;
						const state = { v: 0 };
						gsap.to(state, {
							v: target,
							duration: 0.6,
							ease: 'power2.out',
							scrollTrigger: { trigger: el, start: 'top 95%', once: true },
							onUpdate() {
								el.textContent = state.v.toLocaleString('en-US', {
									minimumFractionDigits: decimals,
									maximumFractionDigits: decimals,
								});
							},
						});
					});

					/* Charts wipe in left-to-right, once. */
					document.querySelectorAll<HTMLElement>('[data-wipe]').forEach((el) => {
						gsap.fromTo(
							el,
							{ clipPath: 'inset(0 100% 0 0)' },
							{
								clipPath: 'inset(0 0% 0 0)',
								duration: 1.1,
								ease: 'power2.inOut',
								scrollTrigger: { trigger: el, start: 'top 85%', once: true },
							},
						);
					});

					/* Quiet reveals for section content. */
					document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
						const items = el.hasAttribute('data-reveal-children')
							? Array.from(el.children)
							: [el];
						gsap.fromTo(
							items,
							{ opacity: 0, y: 14 },
							{
								opacity: 1,
								y: 0,
								duration: 0.7,
								ease: 'power2.out',
								stagger: 0.06,
								scrollTrigger: { trigger: el, start: 'top 88%', once: true },
							},
						);
					});
				});
			}

			document.addEventListener('astro:page-load', init);
		</script>
	</body>
</html>
